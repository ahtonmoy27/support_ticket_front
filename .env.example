# Local development proxy target (used by vite.config.js)
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: Direct API Base URL for frontend requests.
# If omitted, requests go to /api/v1 (handled by vite proxy locally and vercel.json rewrites in production)
# VITE_API_BASE_URL=https://support-api.example.com
